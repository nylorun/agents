          "expect": { "status": 404, "json": { "error": { "code": "not_found", "message": "No route GET /v1/disk" } } }
        },
        {
          "request": { "method": "POST", "path": "/v1/disk", "ticket": "none", "body": { "clear": true } },
          "expect": { "status": 401, "json": { "error": { "code": "unauthorized", "message": "Ticket refused: no ticket" } } }
        }
      ]
    }
  ]
}
