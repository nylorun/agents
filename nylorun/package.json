{
  "name": "nylorun",
  "version": "0.1.1-beta",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Set up and run the local Nylorun stack (Runtime and Studio) with Docker Compose",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/agents.git",
    "directory": "nylorun"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run clean && node ../scripts/check-typescript-version.mjs && tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "check": "npm run build && npm test && node scripts/check-package.mjs",
    "test": "vitest run --passWithNoTests",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@nylorun/core": "0.7.0-beta"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@types/node": "^26.5.0",
    "vitest": "^5.0.1"
  },
  "bin": {
    "nylorun": "dist/cli.js"
  },
  "nylorun": {
    "runtime": "0.12.0-beta",
    "studio": "0.10.1-beta"
  }
}
