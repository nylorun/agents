{
  "name": "nylorun",
  "version": "0.13.0-beta",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Set up and run local Nylorun Tenants (Runtime and Studio) with Docker Compose (nylorun), and the Runtime client of the linked installation (nylo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/agents.git",
    "directory": "nylorun"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run clean && node ../scripts/check-typescript-version.mjs && tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "check": "npm run build && npm test && node scripts/check-package.mjs",
    "test": "vitest run --passWithNoTests",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@nylorun/core": "0.19.0-beta",
    "@nylorun/admin": "0.15.0-beta"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@nylorun/agents": "file:../agents",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@types/node": "^26.6.4",
    "vitest": "^5.0.2"
  },
  "bin": {
    "nylorun": "dist/cli.js",
    "nylo": "dist/nylo.js"
  },
  "nylorun": {
    "runtime": "0.23.0-beta",
    "studio": "0.23.3-beta"
  }
}
