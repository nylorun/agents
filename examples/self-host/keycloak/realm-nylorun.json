{
  "realm": "nylorun",
  "displayName": "Nylorun self-host example",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "agents:read", "description": "Nylorun scope: list the Tenant's agents" },
      { "name": "sessions:own", "description": "Nylorun scope: the person's own sessions" },
      { "name": "studio", "description": "Nylorun scope: sign in to Studio through the proxy" }
    ]
  },
  "users": [
    {
      "username": "ada",
      "email": "ada@example.com",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Operator",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "ada", "temporary": false }],
      "realmRoles": ["agents:read", "sessions:own", "studio"]
    },
    {
      "username": "ben",
      "email": "ben@example.com",
      "emailVerified": true,
      "firstName": "Ben",
      "lastName": "Member",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "ben", "temporary": false }],
      "realmRoles": ["agents:read", "sessions:own"]
    }
  ],
  "clients": [
    {
      "clientId": "nylorun",
      "name": "Nylorun (oauth2-proxy in front of Studio)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "selfhost-example-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4180/oauth2/callback"],
      "webOrigins": ["http://localhost:4180"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4180/*"
      },
      "protocolMappers": [
        {
          "name": "nylorun audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nylorun",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "nylorun_scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "nylorun_scopes",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "org_id",
            "claim.value": "acme",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "nylorun-smoke",
      "name": "Password grant for smoke.sh only (never in production)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "nylorun audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nylorun",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "nylorun_scopes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "nylorun_scopes",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "org_id",
            "claim.value": "acme",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
