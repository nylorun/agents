# Merge into .env for optional domain integrations.
# Configure the chat provider with npm run configure.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# Codex can use its own login, OPENAI_API_KEY, or CODEX_API_KEY.
# npm run triage writes it into the Agent triage's GITHUB_TOKEN slot (a token that reads issues).
GITHUB_TOKEN=
