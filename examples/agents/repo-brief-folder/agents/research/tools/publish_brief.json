{
  "description": "Publish a checked repo brief.",
  "inputSchema": "/schemas/brief.json",
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "title": { "type": "string" },
      "words": { "type": "number" }
    },
    "required": ["id", "title", "words"],
    "additionalProperties": false
  },
  "http": { "url": "http://localhost:3001/publish_brief" }
}
