{
  "name": "@nylorun/example-harness-minimal",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal harness for the Nylorun Runtime, written only against @nylorun/core/harness-api.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\" && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nylorun/core": "file:../../core",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
