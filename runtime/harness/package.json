{
  "name": "@nylorun/harness",
  "version": "0.25.1-beta",
  "description": "Nylorun's TypeScript agent execution engine. See github.com/nylorun/agents.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/agents.git",
    "directory": "runtime/harness"
  },
  "homepage": "https://github.com/nylorun/agents",
  "bugs": "https://github.com/nylorun/agents/issues",
  "author": "Nylo",
  "keywords": [
    "agent",
    "agent-loop",
    "ai",
    "llm",
    "tool-calling",
    "typescript",
    "zod"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./run": {
      "types": "./dist/run/index.d.ts",
      "import": "./dist/run/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./compatibility": {
      "types": "./dist/compatibility.d.ts",
      "import": "./dist/compatibility.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "HOST_CONTRACT.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run clean && node ../../scripts/check-typescript-version.mjs && tsc -p tsconfig.json",
    "check": "npm run format:check && npm run build && npm run test:types && npm test && node scripts/check-package.mjs",
    "typecheck": "node ../../scripts/check-typescript-version.mjs && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:types": "tsc -p test/types/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "prepack": "npm run build",
    "eval:compaction": "vitest run test/compaction-eval.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@nylorun/core": "0.19.0-beta"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  }
}
