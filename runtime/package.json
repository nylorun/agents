{
  "name": "@nylorun/runtime",
  "version": "0.12.0-beta",
  "description": "Nylorun Runtime: the agent execution Host on Postgres, Restate and S2, and model providers.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/agents.git",
    "directory": "runtime"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./core": {
      "types": "./dist/core/runtime.d.ts",
      "import": "./dist/core/runtime.js"
    },
    "./server": "./dist/host/main.js",
    "./configuration": {
      "types": "./dist/configuration.d.ts",
      "import": "./dist/configuration.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run clean && node ../scripts/check-typescript-version.mjs && tsc -p tsconfig.json",
    "check": "npm run build && npm test && node scripts/check-package.mjs",
    "typecheck": "node ../scripts/check-typescript-version.mjs && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:stack:up": "node test/stack/up.mjs up",
    "test:stack:down": "node test/stack/up.mjs down",
    "test:openshell:up": "node test/openshell/up.mjs up",
    "test:openshell:down": "node test/openshell/up.mjs down",
    "prepack": "npm run build",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "start": "node dist/host/main.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@earendil-works/pi-ai": "0.87.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nylorun/core": "0.7.0-beta",
    "@nylorun/harness": "0.19.2-beta",
    "@restatedev/restate-sdk": "1.16.9",
    "@s2-dev/streamstore": "0.27.0",
    "just-bash": "3.4.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.0",
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "hono": "^4.13.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  }
}
