{
  "name": "@nylorun/cli",
  "version": "0.5.0-beta",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Nylorun Runtime client: Tenants, Project links and model providers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/agents.git",
    "directory": "cli"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run clean && node ../scripts/check-typescript-version.mjs && tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "check": "npm run build && npm test && node scripts/check-package.mjs",
    "test": "vitest run --passWithNoTests",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@nylorun/agents": "0.9.0-beta",
    "@nylorun/admin": "0.5.0-beta",
    "@earendil-works/pi-ai": "0.87.0"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@types/node": "^26.5.0",
    "vitest": "^5.0.1"
  },
  "bin": {
    "nylo": "dist/cli.js"
  }
}
