{
  "name": "@nylorun/cli",
  "version": "0.17.7-beta",
  "type": "module",
  "license": "Apache-2.0",
  "description": "nylorun under another name: npx @nylorun/cli <command> runs npx nylorun <command>.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/agents.git",
    "directory": "cli/legacy"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run clean && node ../../scripts/check-typescript-version.mjs && tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "check": "npm run build && npm test && node scripts/check-package.mjs",
    "test": "vitest run --passWithNoTests",
    "prepack": "npm run build"
  },
  "dependencies": {
    "nylorun": "0.22.0-beta"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@types/node": "^26.6.5",
    "vitest": "^5.0.4"
  },
  "bin": {
    "nylorun": "dist/cli.js"
  }
}
