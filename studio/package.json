{
  "name": "@nylorun/studio",
  "version": "0.22.0-beta",
  "private": true,
  "description": "The Nylorun Studio server: the dashboard and trusted Runtime proxy that ghcr.io/nylorun/studio runs. Private; ships only as that image.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/agents.git",
    "directory": "studio"
  },
  "homepage": "https://docs.nylorun.com",
  "bugs": "https://github.com/nylorun/agents/issues",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run typecheck && npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "check": "npm run build && node scripts/check-package.mjs && npm test",
    "test": "npm run build:server && node --experimental-strip-types --test test/*.test.ts test/*.test.mjs scripts/*.test.mjs",
    "test:embed": "npm run build && node --experimental-strip-types --test --test-concurrency=1 test/embed.e2e.ts",
    "test:e2e": "npm run build && node --experimental-strip-types --test --test-concurrency=1 test/*.e2e.ts",
    "test:events": "node --experimental-strip-types --test test/*.test.mjs scripts/event-presentation.test.mjs scripts/workflow-*.test.mjs scripts/iteration-timeline.test.mjs scripts/bundle-boundaries.test.mjs",
    "typecheck": "node ../scripts/check-typescript-version.mjs && tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@nylorun/admin": "0.11.1-beta",
    "@nylorun/agents": "0.16.0-beta"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.49.0",
    "playwright": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1"
  }
}
