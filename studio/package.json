{
  "name": "@nylorun/studio",
  "version": "0.9.0-beta",
  "description": "Local developer Studio for Nylorun agents. Docs: docs.nylorun.com.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nylorun/harness.git",
    "directory": "studio"
  },
  "homepage": "https://docs.nylorun.com",
  "bugs": "https://github.com/nylorun/harness/issues",
  "keywords": [
    "agent",
    "ai",
    "developer-tools",
    "harness",
    "studio"
  ],
  "types": "./dist/index.d.ts",
  "bin": {
    "nylorun-studio": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/ui-digest.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run typecheck && npm run build:server && npm run build:web && node scripts/pack-ui.mjs",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "pack-ui": "node scripts/pack-ui.mjs",
    "check": "npm run build && node scripts/check-package.mjs && npm test",
    "test": "npm run build:server && node --experimental-strip-types --test test/*.test.ts test/*.test.mjs scripts/*.test.mjs",
    "test:events": "node --experimental-strip-types --test test/*.test.mjs scripts/event-presentation.test.mjs scripts/workflow-*.test.mjs scripts/iteration-timeline.test.mjs scripts/bundle-boundaries.test.mjs",
    "typecheck": "node ../scripts/check-typescript-version.mjs && tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@nylorun/admin": "0.2.0-beta",
    "@nylorun/agents": "0.6.0-beta"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.2",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0"
  }
}
